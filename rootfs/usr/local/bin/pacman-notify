#!/bin/bash
# Check for available package updates and notify user

# Count available updates
UPDATES=$(pacman -Qu 2>/dev/null | wc -l)

if [ "$UPDATES" -gt 0 ]; then
    # Get list of packages (limit to first 10)
    PACKAGE_LIST=$(pacman -Qu 2>/dev/null | head -10 | awk '{print $1}' | tr '\n' ' ')
    
    if [ "$UPDATES" -gt 10 ]; then
        PACKAGE_LIST="$PACKAGE_LIST... and $((UPDATES - 10)) more"
    fi
    
    echo "NOTIFY {\"urgency\": \"normal\", \"title\": \"UPDATES AVAILABLE\", \"body\": \"$UPDATES packages can be updated:\\n$PACKAGE_LIST\"}"
else
    echo "System is up to date"
fi
