#!/usr/bin/python3 -u

# ruff: noqa: E501,PTH123,PTH116,SIM115

"""Script that monitors auditd logs to send relevant Desktop notifications."""

import json
import os
import re
import sys
import time
from io import TextIOWrapper
from traceback import format_exc
from typing import Iterable, Tuple

DEFAULT_SLEEP = 1
LOG_FILE = "/var/log/audit/audit.log"


def follow_auditd_events() -> Iterable[str]:
    boot_time = None

    with open("/proc/stat") as file:
        for line in file:
            if line.startswith("btime"):
                boot_time = int(line.split()[1])
                break

    if not boot_time:
        raise ValueError("Unable to find boot time")

    stat = os.stat(LOG_FILE)
    log_size = stat.st_size
    log_inode = stat.st_ino

    logdata = open(LOG_FILE)

    line = logdata.readline()

    while line:
        match = re.search(r"audit\((\d+)\.\d+:\d+\)", line)

        if not match:
            line = logdata.readline()
            continue

        timestamp = int(match.group(1))

        if timestamp > boot_time:
            logdata.seek(logdata.tell() - len(line))
            break

        line = logdata.readline()

    while True:
        logdata, log_inode, log_size = reopen_logfile_if_needed(
            logdata,
            log_inode,
            log_size,
        )

        yield from logdata

        time.sleep(DEFAULT_SLEEP)


def reopen_logfile_if_needed(
    logdata: TextIOWrapper,
    log_inode: int,
    log_size: int,
) -> Tuple[TextIOWrapper, int, int]:
    while True:
        try:
            stat = os.stat(LOG_FILE)

            if stat.st_ino != log_inode:
                old = logdata
                logdata = open(LOG_FILE)
                old.close()

                log_inode = stat.st_ino
                log_size = stat.st_size

            if stat.st_size < log_size:
                logdata.seek(0)
                log_size = stat.st_size

            if stat.st_size > log_size:
                log_size = stat.st_size

            return logdata, log_inode, log_size

        except FileNotFoundError:
            time.sleep(DEFAULT_SLEEP)


def parse_auditd_entry(event: str) -> dict[str, str]:
    log_entry: dict[str, str] = {}

    event = event.replace("msg=audit(", "timestamp=")
    event = event.replace("msg='", "")
    event = event.replace("'", "")

    match = re.search(r"timestamp=(\d+\.\d+):(\d+)", event)

    if match:
        event = re.sub(
            r"timestamp=(\d+\.\d+):(\d+)",
            rf"timestamp={match.group(1)} event_id={match.group(2)}",
            event,
            count=1,
        )

    tokens = event.split()

    for token in tokens:
        parts = token.split("=", 1)

        if len(parts) != 2:
            continue

        key, value = parts

        key = key.strip()
        value = value.strip()

        if not key or not value:
            continue

        if len(value) >= 2 and (
            (value[0] == '"' and value[-1] == '"')
            or (value[0] == "'" and value[-1] == "'")
        ):
            value = value[1:-1]

        log_entry[key] = value

    return log_entry


def notify(title: str, body: str) -> None:
    print(
        "NOTIFY",
        json.dumps(
            {
                "urgency": "critical",
                "title": title,
                "body": body,
            }
        ),
    )


def notify_if_relevant(log_entry: dict[str, str]) -> None:
    event_type = log_entry.get("type")

    if log_entry.get("apparmor") == "DENIED":
        title = "APPARMOR DENIAL"
        body = (
            f"Profile: {log_entry.get('profile', 'unknown')}\n"
            f"Operation: {log_entry.get('operation', 'unknown')}\n"
            f"On: {log_entry.get('name', 'unknown')}\n"
            f"By: {log_entry.get('FSUID', 'unknown')}\n"
            f"Denied: {log_entry.get('denied_mask', 'unknown')}"
        )

    elif event_type == "SECCOMP" and "firejail" in log_entry.get("subj", ""):
        title = "FIREJAIL DENIAL (SECCOMP)"
        body = (
            f"Program: {log_entry.get('exe', 'unknown')}\n"
            f"PID: {log_entry.get('pid', 'unknown')}\n"
            f"User: {log_entry.get('AUID', 'unknown')}"
        )

    elif event_type == "ANOM_ABEND" and "firejail" in log_entry.get("subj", ""):
        title = "PROGRAM CRASHED (COREDUMP)"
        body = (
            f"Program: {log_entry.get('exe', 'unknown')}\n"
            f"PID: {log_entry.get('pid', 'unknown')}\n"
            f"Signal: {log_entry.get('sig', 'unknown')}\n"
            f"User: {log_entry.get('AUID', 'unknown')}"
        )

    elif event_type == "ANOM_PROMISCUOUS" and log_entry.get("prom") != "0":
        title = "INTERFACE IN PROMISCUOUS MODE"
        body = (
            f"Interface: {log_entry.get('dev', 'unknown')}\n"
            f"User: {log_entry.get('AUID', 'unknown')}\n\n"
            "Someone might be listening to your network traffic!"
        )

    elif event_type == "USER_AUTH" and log_entry.get("res") == "failed":
        title = "AUTHENTICATION FAILURE"
        body = (
            f"From: {log_entry.get('UID', 'unknown')}\n"
            f"Using: {log_entry.get('exe', 'unknown')}"
        )

    elif event_type == "SYSCALL" and log_entry.get("key") == "sensitive_files":
        title = "SENSITIVE FILE ACCESS"
        body = (
            f"File: {log_entry.get('name', 'unknown')}\n"
            f"From: {log_entry.get('AUID', 'unknown')}\n"
            f"Using: {log_entry.get('exe', 'unknown')}\n"
            f"Syscall: {log_entry.get('SYSCALL', 'unknown')}\n"
            f"Success: {log_entry.get('success', 'unknown')}"
        )

    elif event_type == "SYSCALL" and log_entry.get("key") == "rootkit":
        title = "ROOTKIT BEHAVIOR DETECTED"
        body = (
            f"File: {log_entry.get('name', 'unknown')}\n"
            f"From: {log_entry.get('AUID', 'unknown')}\n"
            f"Using: {log_entry.get('exe', 'unknown')}\n"
            f"Syscall: {log_entry.get('SYSCALL', 'unknown')}\n"
            f"Success: {log_entry.get('success', 'unknown')}"
        )

    elif event_type == "SYSCALL" and log_entry.get("key") == "secure_boot":
        title = "SECURE BOOT ACCESS"
        body = (
            f"File: {log_entry.get('name', 'unknown')}\n"
            f"From: {log_entry.get('AUID', 'unknown')}\n"
            f"Using: {log_entry.get('exe', 'unknown')}\n"
            f"Syscall: {log_entry.get('SYSCALL', 'unknown')}\n"
            f"Success: {log_entry.get('success', 'unknown')}"
        )

    elif (
        event_type == "SYSCALL"
        and log_entry.get("key") == "auditd_tampering"
        and log_entry.get("exe") != "/usr/bin/pacman"
    ):
        title = "AUDITD TAMPERING"
        body = (
            f"From: {log_entry.get('AUID', 'unknown')}\n"
            f"Using: {log_entry.get('exe', 'unknown')}\n"
            f"Syscall: {log_entry.get('SYSCALL', 'unknown')}\n"
            f"Success: {log_entry.get('success', 'unknown')}"
        )

    elif event_type == "SYSCALL" and log_entry.get("key") == "power_abuse":
        title = "PRIVILEGED PROCESS USING HOME DIRECTORY"
        body = (
            f"From: {log_entry.get('AUID', 'unknown')}\n"
            f"Using: {log_entry.get('exe', 'unknown')}\n"
            f"Syscall: {log_entry.get('SYSCALL', 'unknown')}\n"
            f"Success: {log_entry.get('success', 'unknown')}"
        )

    elif event_type == "SYSCALL" and log_entry.get("key") == "network_config":
        title = "NETWORK CONFIGURATION CHANGED"
        body = (
            f"File: {log_entry.get('name', 'unknown')}\n"
            f"From: {log_entry.get('AUID', 'unknown')}\n"
            f"Using: {log_entry.get('exe', 'unknown')}\n"
            f"Success: {log_entry.get('success', 'unknown')}"
        )

    elif event_type == "SYSCALL" and log_entry.get("key") == "systemd_config":
        title = "SYSTEMD SERVICE MODIFIED"
        body = (
            f"File: {log_entry.get('name', 'unknown')}\n"
            f"From: {log_entry.get('AUID', 'unknown')}\n"
            f"Using: {log_entry.get('exe', 'unknown')}\n"
            f"Success: {log_entry.get('success', 'unknown')}"
        )

    else:
        return

    notify(title, body)


def main() -> None:
    try:
        for event in follow_auditd_events():
            parsed_event = parse_auditd_entry(event)
            notify_if_relevant(parsed_event)

    except Exception:
        notify("AUDITD LOGS MONITORING FAILURE", format_exc())
        sys.exit(1)


if __name__ == "__main__":
    main()