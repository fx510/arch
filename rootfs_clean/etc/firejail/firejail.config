# Firejail global configuration
# See man firejail-config for details

# Restrict user namespaces (security)
# Set to yes to allow, no to block
restricted-network yes

# Force use of seccomp filters
seccomp-filter-add yes

# Enable AppArmor integration if available
apparmor yes

# Disable X11 sandboxing (we're Wayland-only)
x11 no

# Enable private /tmp by default
private-tmp yes

# Disable 3D acceleration by default (can be overridden per-app)
nodvd yes
nogroups yes
nou2f yes

# Quiet mode (less verbose output)
quiet yes

# Browser-specific: disable U2F by default (enable per-app if needed)
browser-disable-u2f yes

# Whitelist mode: only allow explicitly whitelisted apps
# Set to yes for maximum security (requires per-app configs)
whitelist no

# Network filter: block by default, allow per-app
net none

# Force DNS through system resolver (prevents DNS leaks)
dns 127.0.0.53
